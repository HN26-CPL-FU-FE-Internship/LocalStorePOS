# Copy the values for your environment into the shell, Docker, or deployment platform.
# Do not commit a real .env file.

# ------------------------------
# Local development
# ------------------------------
SPRING_PROFILES_ACTIVE=local
PORT=8080
DB_HOST=localhost
DB_PORT=3306
DB_NAME=restaurant_pos_db
DB_USERNAME=root
DB_PASSWORD=1234
JWT_SIGNER_KEY=local-only-change-this-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Cloudinary is optional for starting the local app, but required for uploads.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ------------------------------
# Production example (Aiven MySQL)
# ------------------------------
# SPRING_PROFILES_ACTIVE=prod
# PORT=8080
# DB_HOST=your-aiven-host
# DB_PORT=your-aiven-port
# DB_NAME=defaultdb
# DB_USERNAME=restaurant_pos_app
# DB_PASSWORD=replace-with-a-secret
# JWT_SIGNER_KEY=replace-with-a-long-random-secret
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
